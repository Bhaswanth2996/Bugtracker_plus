{
  "name": "bugtracker-plus",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "docker compose up --build",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "python3 -m uvicorn app.main:app --reload --app-dir backend --host 0.0.0.0 --port 8000",
    "build:frontend": "npm --prefix frontend run build",
    "lint:frontend": "npm --prefix frontend run lint",
    "test:backend": "PYTHONPATH=backend python3 -m pytest backend/tests -q",
    "test:e2e": "PYTHONPATH=backend python3 -m pytest backend/tests -m e2e -q"
  }
}
